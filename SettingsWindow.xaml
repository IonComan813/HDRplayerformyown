<ui:FluentWindow
    x:Class="HdrPlayer.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="全局设置"
    Width="920"
    Height="700"
    MinWidth="760"
    MinHeight="480"
    Icon="pack://application:,,,/Assets/HdrPlayer.ico"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Title="全局设置" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 左侧导航 -->
        <ListBox
            x:Name="Nav"
            Grid.Row="1"
            Grid.Column="0"
            Margin="8,4,4,0"
            Background="Transparent"
            BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6" Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,12,0" FontSize="18" Symbol="{Binding Icon}" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 右侧内容 -->
        <ScrollViewer
            x:Name="PageScroller"
            Grid.Row="1"
            Grid.Column="1"
            Padding="16,0,20,12"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageHost" />
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="16,12"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button x:Name="BtnOk" MinWidth="96" Margin="0,0,8,0" Appearance="Primary" Content="确定" IsDefault="True" />
                <ui:Button x:Name="BtnCancel" MinWidth="96" Content="取消" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
