<ui:FluentWindow
    x:Class="HdrPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:HdrPlayer"
    Title="HdrPlayer"
    Icon="pack://application:,,,/Assets/HdrPlayer.ico"
    Width="1600"
    Height="960"
    MinWidth="640"
    MinHeight="400"
    AllowDrop="True"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="Manual">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="HdrPlayer">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="16" Height="16" Source="pack://application:,,,/Assets/HdrPlayer.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 视频区域：mpv 的原生窗口放在这里。四周留 4px 给窗口的缩放边框（原生子窗口会挡住鼠标）。 -->
            <Border x:Name="VideoFrame" Grid.Column="0" Margin="4,0,4,4" Background="Black">
                <local:VideoHost x:Name="Video" />
            </Border>

            <!-- 播放列表 -->
            <Border
                x:Name="PlaylistPanel"
                Grid.Column="1"
                Width="320"
                Margin="0,0,4,4"
                AllowDrop="True"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <DockPanel>
                    <Grid Margin="12,8,6,6" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="播放列表" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button x:Name="BtnPlAdd" Appearance="Transparent" BorderThickness="0" Padding="8,6" ToolTip="添加文件" Icon="{ui:SymbolIcon Add24}" />
                            <ui:Button x:Name="BtnPlRemove" Appearance="Transparent" BorderThickness="0" Padding="8,6" ToolTip="移除选中项 (Delete)" Icon="{ui:SymbolIcon Delete24}" />
                            <ui:Button x:Name="BtnPlClear" Appearance="Transparent" BorderThickness="0" Padding="8,6" ToolTip="清空" Icon="{ui:SymbolIcon DeleteDismiss24}" />
                            <ui:Button x:Name="BtnPlClose" Appearance="Transparent" BorderThickness="0" Padding="8,6" ToolTip="关闭 (P)" Icon="{ui:SymbolIcon Dismiss24}" />
                        </StackPanel>
                    </Grid>
                    <ListBox
                        x:Name="PlaylistBox"
                        Margin="4,0,4,6"
                        AllowDrop="True"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PlaylistEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        x:Name="Marker"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Filled="True"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Symbol="Play24"
                                        Visibility="Hidden" />
                                    <TextBlock
                                        x:Name="Label"
                                        Grid.Column="1"
                                        Text="{Binding Display}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Path}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Current}" Value="True">
                                        <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="PlMenuPlay" Header="播放" InputGestureText="Enter" />
                                <MenuItem x:Name="PlMenuRemove" Header="移除" InputGestureText="Delete" />
                                <MenuItem x:Name="PlMenuReveal" Header="在资源管理器中显示" />
                                <Separator />
                                <MenuItem x:Name="PlMenuInfo" Header="视频参数…" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
