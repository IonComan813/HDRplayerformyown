<ui:FluentWindow
    x:Class="HdrPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:HdrPlayer"
    Title="HdrPlayer"
    Icon="pack://application:,,,/Assets/HdrPlayer.ico"
    Width="1600"
    Height="960"
    MinWidth="640"
    MinHeight="400"
    AllowDrop="True"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="Manual">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="HdrPlayer">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="16" Height="16" Source="pack://application:,,,/Assets/HdrPlayer.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 视频区域：mpv 的原生窗口放在这里。四周留 4px 给窗口的缩放边框（原生子窗口会挡住鼠标）。 -->
            <Border x:Name="VideoFrame" Grid.Column="0" Margin="4,0,4,4" Background="Black">
                <local:VideoHost x:Name="Video" />
            </Border>

            <!-- 播放列表 -->
            <Border
                x:Name="PlaylistPanel"
                Grid.Column="1"
                Width="320"
                Margin="0,0,4,4"
                AllowDrop="True"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <DockPanel>
                    <Grid Margin="12,8,6,6" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="播放列表" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button x:Name="BtnPlAdd" Appearance="Transparent" BorderThickness="0" Padding="8,6" ToolTip="添加文件" Icon="{ui:SymbolIcon Add24}" />
                            <ui:Button x:Name="BtnPlRemove" Appearance="Transparent" BorderThickness="0" Padding="8,6" ToolTip="移除选中项 (Delete)" Icon="{ui:SymbolIcon Delete24}" />
                            <ui:Button x:Name="BtnPlClear" Appearance="Transparent" BorderThickness="0" Padding="8,6" ToolTip="清空" Icon="{ui:SymbolIcon DeleteDismiss24}" />
                            <ui:Button x:Name="BtnPlClose" Appearance="Transparent" BorderThickness="0" Padding="8,6" ToolTip="关闭 (P)" Icon="{ui:SymbolIcon Dismiss24}" />
                        </StackPanel>
                    </Grid>
                    <!-- Ctrl / Shift 多选；正在播放的那一项用强调色的文字表示，进度处显示“播放中” -->
                    <ListBox
                        x:Name="PlaylistBox"
                        Margin="4,0,4,6"
                        AllowDrop="True"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionMode="Extended"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PlaylistEntry}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 缩略图：上次退出 / 切走时那个位置的画面 -->
                                    <Border
                                        x:Name="ThumbFrame"
                                        Grid.Column="0"
                                        Width="116"
                                        Height="67"
                                        VerticalAlignment="Top"
                                        Background="#FF161616"
                                        CornerRadius="5">
                                        <Grid>
                                            <ui:SymbolIcon
                                                x:Name="Placeholder"
                                                FontSize="22"
                                                Foreground="#80FFFFFF"
                                                Symbol="VideoClip24" />
                                            <Image
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="{Binding Thumbnail}"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <!-- 文件名在上（自动换行，最多 3 行，再长就在第 3 行末尾显示…，整行高度不超过缩略图），
                                         进度在下、和缩略图底边对齐，两者左对齐。3 × 16 + 2 + 进度一行 ≈ 缩略图高 67 -->
                                    <Grid Grid.Column="1" Margin="10,0,2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="2" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            x:Name="Label"
                                            Grid.Row="0"
                                            MaxHeight="48"
                                            FontSize="13"
                                            LineHeight="16"
                                            LineStackingStrategy="BlockLineHeight"
                                            Text="{Binding Display}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            ToolTip="{Binding Path}" />
                                        <!-- 上次的进度 / 片长，正在播放时显示“播放中” -->
                                        <TextBlock
                                            x:Name="ProgressText"
                                            Grid.Row="2"
                                            Margin="0,0,0,1"
                                            HorizontalAlignment="Left"
                                            FontSize="11"
                                            FontFamily="Segoe UI"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Progress}" />
                                        <TextBlock
                                            x:Name="FailedText"
                                            Grid.Row="2"
                                            Margin="0,0,0,1"
                                            HorizontalAlignment="Left"
                                            FontSize="11"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Text="无法打开，可右键 → 修复视频"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                        <Setter TargetName="Placeholder" Property="Symbol" Value="MusicNote224" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                        <Setter TargetName="Placeholder" Property="Symbol" Value="VideoClipOff24" />
                                        <Setter TargetName="FailedText" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="ProgressText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Current}" Value="True">
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="ProgressText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <!-- 选中多项时只留“移除”（见 OnPlaylistMenuOpening） -->
                            <ContextMenu>
                                <MenuItem x:Name="PlMenuPlay" Header="播放" InputGestureText="Enter" />
                                <MenuItem x:Name="PlMenuRemove" Header="移除" InputGestureText="Delete" />
                                <MenuItem x:Name="PlMenuReveal" Header="在资源管理器中显示" />
                                <Separator x:Name="PlMenuSep" />
                                <MenuItem x:Name="PlMenuRepair" Header="修复视频（重新封装）…" />
                                <MenuItem x:Name="PlMenuInfo" Header="视频参数…" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
