<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe / 任务栏图标：手绘场记板，生成脚本见 Assets/make_icon.py -->
    <ApplicationIcon>Assets\HdrPlayer.ico</ApplicationIcon>
    <AssemblyName>HdrPlayer</AssemblyName>
    <RootNamespace>HdrPlayer</RootNamespace>
    <Version>0.2.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fluent 风格控件库：https://github.com/lepoco/wpfui -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\HdrPlayer.png" />
    <Resource Include="Assets\HdrPlayer.ico" />
    <None Remove="Assets\make_icon.py" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把 libmpv-2.dll 放在项目目录下即可自动复制到输出目录 -->
    <None Include="libmpv-2.dll" Condition="Exists('libmpv-2.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
