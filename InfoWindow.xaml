<ui:FluentWindow
    x:Class="HdrPlayer.InfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="视频参数"
    Width="840"
    Height="780"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="视频参数" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Info24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border
            Grid.Row="1"
            Margin="12,0,12,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBox
                x:Name="InfoText"
                Padding="10,8"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="{StaticResource MonoFont}"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="False"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel
            Grid.Row="2"
            Margin="12"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <CheckBox x:Name="AutoRefresh" Margin="0,0,16,0" VerticalAlignment="Center" Content="自动刷新" IsChecked="True" />
            <ui:Button x:Name="BtnRefresh" Margin="0,0,8,0" Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" />
            <ui:Button x:Name="BtnCopy" Margin="0,0,8,0" Content="复制" Icon="{ui:SymbolIcon Copy24}" />
            <ui:Button x:Name="BtnClose" Appearance="Primary" Content="关闭" MinWidth="80" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
