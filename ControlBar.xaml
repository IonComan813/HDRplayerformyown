<Window
    x:Class="HdrPlayer.ControlBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HdrPlayer 控制栏"
    Width="900"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowActivated="False"
    Focusable="False"
    AllowDrop="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="BarButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            进度条 / 音量条：WPF-UI 的 Slider 只画灰色轨道和圆点，已播放的部分是透明的。
            这里沿用它的横向模板，只把圆点左边（Track 的 DecreaseRepeatButton）画成和圆点同色的强调色。
        -->
        <Style x:Key="SliderFilledPart" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!--
                            透明的外框保证整个高度都能点；里面 4 像素高的条和灰色轨道对齐。
                            右边多画半个圆点的宽度（负边距，伸到圆点下面），蓝条一直接到圆点中心，中间不露灰色轨道
                        -->
                        <Border Background="Transparent">
                            <Border
                                Height="4"
                                Margin="0,0,-9,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SliderThumbBackground}"
                                CornerRadius="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmptyPart" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            圆点：WPF-UI 原来的圆点外面有一圈灰色的外环（SliderOuterThumbBackground），夹在蓝条和蓝点之间像一截灰色。
            这里只保留强调色的圆点，悬停 / 拖动时稍微放大（和 Windows 11 的滑块一样）
        -->
        <Style x:Key="FilledSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource SliderThumbBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse
                                x:Name="Dot"
                                Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="16" />
                                <Setter TargetName="Dot" Property="Height" Value="16" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="16" />
                                <Setter TargetName="Dot" Property="Height" Value="16" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="FilledSlider" TargetType="Slider">
            <Grid>
                <Border
                    x:Name="TrackBackground"
                    Height="4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SliderTrackFill}"
                    CornerRadius="2" />
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFilledPart}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="Thumb" Style="{StaticResource FilledSliderThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyPart}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPointerOver}" />
                    <Setter TargetName="Thumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- 四周的透明边距不接收鼠标，点击会落到下面的视频上 -->
    <Grid x:Name="Root" Margin="16,8,16,16" Opacity="0">
        <Border
            Background="{StaticResource OverlayCardBrush}"
            BorderBrush="{StaticResource OverlayStrokeBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,4,12,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第一行：时间 + 进度条 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TimeText"
                        Grid.Column="0"
                        MinWidth="64"
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        Text="00:00"
                        TextAlignment="Center" />
                    <Grid Grid.Column="1" Margin="8,0">
                        <Slider
                            x:Name="SeekSlider"
                            Template="{StaticResource FilledSlider}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsMoveToPointEnabled="True"
                            Maximum="1"
                            Minimum="0" />
                    </Grid>
                    <TextBlock
                        x:Name="DurationText"
                        Grid.Column="2"
                        MinWidth="64"
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="00:00"
                        TextAlignment="Center" />
                </Grid>

                <!-- 第二行：按钮 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:Button x:Name="BtnOpen" Style="{StaticResource BarButton}" ToolTip="打开文件 (Ctrl+O)" Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button x:Name="BtnPrev" Style="{StaticResource BarButton}" ToolTip="上一个 (PgUp)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Previous24" Filled="True" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="BtnPlay" Style="{StaticResource BarButton}" Width="46" ToolTip="播放 / 暂停 (空格)" FontSize="22">
                            <ui:Button.Icon>
                                <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" Filled="True" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="BtnNext" Style="{StaticResource BarButton}" ToolTip="下一个 (PgDn)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Next24" Filled="True" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="FormatText"
                        Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button x:Name="BtnMute" Style="{StaticResource BarButton}" ToolTip="静音 (M)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon x:Name="MuteIcon" Symbol="Speaker224" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <Slider
                            x:Name="VolumeSlider"
                            Template="{StaticResource FilledSlider}"
                            Width="110"
                            Margin="2,0,8,0"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsMoveToPointEnabled="True"
                            Maximum="150"
                            Minimum="0" />
                        <!-- 不固定宽度，按文字自适应，避免 “HDR” 的 R 被裁掉 -->
                        <ui:Button
                            x:Name="BtnHdr"
                            Style="{StaticResource BarButton}"
                            Width="Auto"
                            MinWidth="56"
                            Padding="10,0"
                            Content="HDR"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            FontWeight="Bold"
                            ToolTip="开关 HDR 输出 (H)" />
                        <ui:Button x:Name="BtnReload" Style="{StaticResource BarButton}" ToolTip="重新载入当前文件，让设置立即生效 (F5)" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        <ui:Button x:Name="BtnPlaylist" Style="{StaticResource BarButton}" ToolTip="播放列表 (P)" Icon="{ui:SymbolIcon TextBulletListLtr24}" />
                        <ui:Button x:Name="BtnSettings" Style="{StaticResource BarButton}" ToolTip="全局设置" Icon="{ui:SymbolIcon Settings24}" />
                        <ui:Button x:Name="BtnFull" Style="{StaticResource BarButton}" ToolTip="全屏 (F / 双击)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon x:Name="FullIcon" Symbol="FullScreenMaximize24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
